{
  "engines": {
    "node": "^26.13.0"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@types/chrome": "^0.3.7",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "semantic-release": "^25.0.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "scripts": {
    "build": "node scripts/build-content-standalone.js && tsc",
    "watch": "tsc --watch",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "rebuild": "npm run clean && npm run build",
    "prepare": "npm run build && node scripts/update-manifest-version.js",
    "test": "npm run build && node --test tests/browser.test.mjs",
    "benchmark": "npm run build && node tests/benchmarks/run.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  }
}
